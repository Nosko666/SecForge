    "dep_checker": "osv-scanner",
    "nuclei_tags_boost": ["nodejs", "express", "nextjs", "nuxtjs", "javascript", "npm"],
    "nuclei_tags_skip": ["wordpress", "php", "java", "spring", "ruby", "rails", "python", "django", "flask"],
    "common_endpoints": ["/api/", "/graphql", "/.env", "/.git/HEAD", "/package.json", "/robots.txt"],
    "priority_boosts": { "secrets": 1.3, "deps": 1.2, "headers": 1.1 },
    "fix_hints": {
      "headers": "Add security headers via Express middleware (helmet) or server framework settings",
      "tls": "Configure TLS securely (TLS1.2/1.3 only) and prefer modern ciphers",
      "secrets": "Use .env + .gitignore, never commit secrets; rotate leaked credentials immediately",
      "deps": "Use npm/yarn lockfiles and patch vulnerable dependencies promptly"
    },
    "suggested_extras": [
      { "tool": "trivy", "reason": "Scans the server OS for vulnerable system packages. Adds ~2 min." },
      { "tool": "interactsh", "reason": "Captures out-of-band callbacks for blind SSRF/XSS/injection (used by some nuclei templates)." }
    ]
  },
