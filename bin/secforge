#!/usr/bin/env bash
# SecForge CLI — one command to rule them all.
# Dispatches to scan scripts, v2 Python modules, and utility commands.
set -euo pipefail

SECFORGE_ROOT="${SECFORGE_ROOT:-/opt/secforge}"
SCRIPT_DIR="${SECFORGE_ROOT}/scripts"
PYTHONPATH="${SCRIPT_DIR}:${PYTHONPATH:-}"
export PYTHONPATH
export PYTHONDONTWRITEBYTECODE=1

sf_die() { printf '[secforge] ERROR: %s\n' "$*" >&2; exit 1; }

sf_start_dashboard() {
  if [[ -n "${TMUX:-}" ]]; then
    # Already in tmux — split pane (non-blocking, scan continues in current pane)
    tmux split-window -h -d -p 40 "bash ${SECFORGE_ROOT}/scripts/dashboard.sh --start"
    tmux select-pane -t '{right}' -T secforge-dashboard 2>/dev/null || true
  elif command -v tmux >/dev/null 2>&1; then
    # Not in tmux — start dashboard in a detached tmux session.
    # Scan continues in the current terminal. User or AI can attach later.
    tmux kill-session -t secforge 2>/dev/null || true
    tmux new-session -d -s secforge "bash ${SECFORGE_ROOT}/scripts/dashboard.sh --start"
    tmux select-pane -t secforge:0.0 -T secforge-dashboard 2>/dev/null || true
    echo "[secforge] Dashboard running in tmux session 'secforge'. Attach with: tmux attach -t secforge" >&2
  else
    echo "[secforge] WARN: tmux not available. Dashboard requires tmux." >&2
  fi
}

show_help() {
  cat <<'EOF'
SecForge — AI-guided security toolkit

Usage: secforge <command> [options]

Scanning:
  scan <target>                Quick Tier-1 scan (passive/safe)
  scan --full <target>         Full scan (Tier 1 + Tier 2 opt-in)
    --stack <profile>          Use stack profile (e.g., node-nginx, wordpress)
    --skip <tools>             Skip specific tools (CSV)
    --code-path <path>         Path to source code for secrets/dep scanning
    --tier 1|2                 Override max tier level
    --dashboard                Open live TUI dashboard in tmux pane

Reporting:
  export --mode <mode> [opts]  Generate AI-ready markdown export
    Modes: quick-fix, fix-pack, full-plan, patch, explain
    --finding SF-###           Select finding (quick-fix, explain)
    --pack <cluster_id>        Select fix pack (fix-pack, patch)
    --detail beginner|operator|analyst
    --session <session_id>     Use specific scan session
    --out <path>               Write to file instead of stdout
    --system <info>            System/OS context for fix generation
    --stack-hints <hints>      Tech stack hints (e.g. "nginx, node"); --stack accepted as alias
    --inspect                  Probe local config files for precise fix locations

Verification:
  verify --finding SF-###      Show verification commands for a finding
  verify --pack FP-xxx         Show verification for a fix pack
    --run                      Execute safe commands (allowlisted)
    --allow-noisy              Also run noisy commands (nmap, testssl.sh)
    --allow-sudo               Also run sudo-gated commands (ufw, iptables, etc.)
    --stage pre|post|both      Filter by verification stage

History & State:
  list                         Open findings grouped by fix pack
  diff                         What changed since last scan
  history --finding SF-###     Full history for one finding
  list --regressions           Most frequently reopened findings
  list --accepted              Accepted risk / ignored / false positive
  list --failed-verifications  Failed verification runs

Management:
  status                       System check (Ubuntu, tools, disk, RAM)
  update                       Update all installed tools
  purge --before <date>        Delete old scan history
    --delete-reports           Also remove report directories
    --dry-run                  Preview what would be deleted
  ignore SF-### --reason "..." Mark finding as ignored
  accept SF-### --reason "..." Mark finding as accepted risk
  false-positive SF-### --reason "..." Mark as false positive

Setup:
  init                         Interactive setup wizard
    --domain <domain>          Pre-authorize a domain (repeatable)
    --environment prod|staging Set environment type
    --payments yes|no          Enable payment security checks
    --admin-ip <ip>            Whitelist admin IP for hardening
    --tier 1|2                 Set max scanning tier (1=passive, 2=active)
    --reset                    Reset config from template (with backup)
  install <tool> [tool...]     Install security tools from catalog
  install --list               Show all available tools
  install --all                Install all non-builtin tools
  dashboard                    Open live TUI dashboard
    --start                    Open dashboard pane (default)
    --restart                  Kill and reopen dashboard
    --last                     Show last scan's dashboard
    --close                    Close dashboard pane

Other:
  version                      Show SecForge version
  help                         Show this help
EOF
}

cmd="${1:-help}"
shift 2>/dev/null || true

case "${cmd}" in
  scan)
    _sf_full=0; _sf_dashboard=0; _sf_target=""
    while [[ "${#}" -gt 0 ]]; do
      case "$1" in
        --full) _sf_full=1; shift ;;
        --stack) export SECFORGE_STACK="${2:-}"; shift 2 ;;
        --skip) export SECFORGE_SKIP="${2:-}"; shift 2 ;;
        --code-path) export SECFORGE_CODE_PATH="${2:-}"; shift 2 ;;
        --tier)
          [[ "${2:-}" == "1" || "${2:-}" == "2" ]] || sf_die "--tier must be 1 or 2 (got: ${2:-empty})"
          export SECFORGE_TIER_OVERRIDE="${2}"; shift 2 ;;
        --dashboard) _sf_dashboard=1; shift ;;
        -*) sf_die "Unknown scan flag: $1" ;;
        *) _sf_target="$1"; shift ;;
      esac
    done
    [[ -z "${_sf_target}" ]] && sf_die "Usage: secforge scan <target> [--full] [--stack <profile>] [--skip <csv>] [--tier 1|2] [--code-path <path>] [--dashboard]"

    if [[ "${_sf_dashboard}" -eq 1 ]]; then
      sf_start_dashboard
    fi

    if [[ "${_sf_full}" -eq 1 ]]; then
      exec bash "${SCRIPT_DIR}/scan-all.sh" "${_sf_target}"
    else
      exec bash "${SCRIPT_DIR}/scan-quick.sh" "${_sf_target}"
    fi
    ;;

  export)
    # Parse export args and dispatch to Python
    exec python3 -c "
import sys, json, os
sys.path.insert(0, '${SCRIPT_DIR}')
from secforge.export_ai import export, resolve_session, load_findings
from pathlib import Path

args = sys.argv[1:]
mode = ''
finding_id = None
pack_id = None
detail = 'operator'
session_spec = None
out_path = None
system_info = None
stack_hints = None
inspect_mode = False

i = 0
while i < len(args):
    a = args[i]
    if a == '--mode' and i+1 < len(args):
        mode = args[i+1]; i += 2
    elif a == '--finding' and i+1 < len(args):
        finding_id = args[i+1]; i += 2
    elif a == '--pack' and i+1 < len(args):
        pack_id = args[i+1]; i += 2
    elif a == '--detail' and i+1 < len(args):
        detail = args[i+1]; i += 2
    elif a == '--session' and i+1 < len(args):
        session_spec = args[i+1]; i += 2
    elif a == '--in' and i+1 < len(args):
        session_spec = args[i+1]; i += 2
    elif a == '--out' and i+1 < len(args):
        out_path = args[i+1]; i += 2
    elif a == '--system' and i+1 < len(args):
        system_info = args[i+1]; i += 2
    elif a in ('--stack', '--stack-hints') and i+1 < len(args):
        stack_hints = args[i+1]; i += 2
    elif a == '--inspect':
        inspect_mode = True; i += 1
    else:
        i += 1

if not mode:
    print('Error: --mode required (quick-fix|fix-pack|full-plan|patch|explain)', file=sys.stderr)
    sys.exit(2)

reports_dir = Path('${SECFORGE_ROOT}/reports')
fj_path = resolve_session(reports_dir, session_spec)
if not fj_path or not fj_path.exists():
    print('Error: no findings.json found. Run a scan first or specify --session/--in.', file=sys.stderr)
    sys.exit(2)

data = load_findings(fj_path)

# Re-compute fix locations with --inspect if requested
if inspect_mode:
    from secforge.fix_location import FixLocationInference
    catalog_dir = Path('${SCRIPT_DIR}') / '..' / 'catalog'
    catalog_dir = catalog_dir.resolve()
    fli = FixLocationInference(catalog_dir)
    fli.assign_fix_locations(data.get('findings', []), inspect=True)

output = export(mode, data, finding_id=finding_id, pack_id=pack_id, detail=detail,
                system_info=system_info, stack_hints=stack_hints)

if out_path:
    Path(out_path).write_text(output, encoding='utf-8')
    print(f'Written to {out_path}', file=sys.stderr)
else:
    print(output)
" "$@"
    ;;

  verify)
    exec python3 -c "
import sys, json, os
sys.path.insert(0, '${SCRIPT_DIR}')
from secforge.export_ai import resolve_session, load_findings
from secforge.verify import run_verification, write_results, is_safe_command
from pathlib import Path

args = sys.argv[1:]
finding_id = None
pack_id = None
execute = False
allow_noisy = False
allow_sudo = False
stage = None

i = 0
while i < len(args):
    a = args[i]
    if a == '--finding' and i+1 < len(args):
        finding_id = args[i+1]; i += 2
    elif a == '--pack' and i+1 < len(args):
        pack_id = args[i+1]; i += 2
    elif a == '--run':
        execute = True; i += 1
    elif a == '--allow-noisy':
        allow_noisy = True; i += 1
    elif a == '--allow-sudo':
        allow_sudo = True; i += 1
    elif a == '--stage' and i+1 < len(args):
        stage = args[i+1]; i += 2
    else:
        i += 1

reports_dir = Path('${SECFORGE_ROOT}/reports')
fj_path = resolve_session(reports_dir)
if not fj_path or not fj_path.exists():
    print('Error: no findings.json found.', file=sys.stderr)
    sys.exit(2)

data = load_findings(fj_path)

# Build context for placeholder substitution
target = data.get('target', '')
target_url = ''
if target:
    target_url = target if target.startswith('http') else f'https://{target}'
ctx = {'target': target_url, 'host': target}

# Resolve project_id for DB logging
project_id = target or 'default'
scan_id = fj_path.parent.name

# Collect verification checks + resolve fingerprint
checks = []
fingerprint = ''
if finding_id:
    for f in data.get('findings', []):
        if f.get('id') == finding_id:
            checks.extend(f.get('verification', []))
            fingerprint = f.get('fingerprint', '')
            # Fallback: if no finding-level checks, use the pack's checks via cluster_id
            if not checks:
                cid = f.get('cluster_id', 'other')
                pack_lookup = f'FP-{cid}'
                for p in data.get('fix_packs', []):
                    if p.get('fix_pack_id') == pack_lookup:
                        checks.extend(p.get('verification', []))
                        break
            break
elif pack_id:
    normalized = pack_id if pack_id.startswith('FP-') else f'FP-{pack_id}'
    for p in data.get('fix_packs', []):
        if p.get('fix_pack_id') == normalized:
            checks.extend(p.get('verification', []))
            # Use first finding fingerprint for pack-level logging
            fids = p.get('finding_ids', [])
            if fids:
                for f in data.get('findings', []):
                    if f.get('id') == fids[0]:
                        fingerprint = f.get('fingerprint', '')
                        break
            break

if not checks:
    print('No verification checks found for the specified finding/pack.', file=sys.stderr)
    sys.exit(1)

# Dashboard event emission for verify
import json as _json
_sf_status = os.environ.get('SECFORGE_DASHBOARD_STATUS', '')
if not _sf_status and scan_id:
    _sf_status = f'/tmp/secforge-dashboard-{scan_id}.status'
def _emit_verify(evt):
    if not _sf_status: return
    try:
        with open(_sf_status, 'a') as _fh:
            _fh.write(_json.dumps(evt) + '\n')
    except OSError:
        pass

_pack_label = pack_id or finding_id or 'unknown'
_emit_verify({'event': 'verify_start', 'pack': _pack_label, 'checks_total': len(checks)})

results = run_verification(checks, stage_filter=stage, execute=execute, allow_noisy=allow_noisy, allow_sudo=allow_sudo, context=ctx)

# Display results
for r in results:
    status = 'PASS' if r.passed else 'FAIL' if execute else 'SUGGEST'
    print(f'  [{status}] {r.name}')
    if r.command:
        print(f'         {r.command}')
    if r.explain:
        print(f'         {r.explain}')
    if execute and r.actual_output and not r.passed:
        print(f'         Output: {r.actual_output[:200]}')
    print()

passed = sum(1 for r in results if r.passed)
total = len(results)
_emit_verify({'event': 'verify_done', 'pack': _pack_label, 'passed': passed, 'failed': total - passed})
if execute:
    print(f'Results: {passed}/{total} passed')

# Write results to session + DB
session_dir = fj_path.parent
if session_dir.is_dir():
    write_results(results, session_dir, fingerprint=fingerprint, project_id=project_id, scan_id=scan_id)
" "$@"
    ;;

  list)
    exec python3 -c "
import sys
sys.path.insert(0, '${SCRIPT_DIR}')
from secforge.state import StateDB
from secforge.export_ai import resolve_session, load_findings
from pathlib import Path

args = sys.argv[1:]
show_regressions = '--regressions' in args
show_accepted = '--accepted' in args
show_failed_verif = '--failed-verifications' in args

# Determine project_id from latest findings
reports_dir = Path('${SECFORGE_ROOT}/reports')
fj_path = resolve_session(reports_dir)
project_id = 'default'
if fj_path and fj_path.exists():
    data = load_findings(fj_path)
    project_id = data.get('target', 'default')

state = StateDB()
if not state.open():
    # Fallback: read directly from findings.json
    if fj_path and fj_path.exists():
        data = load_findings(fj_path)
        packs = data.get('fix_packs', [])
        findings = data.get('findings', [])
        by_pack = {}
        for f in findings:
            cid = f.get('cluster_id', 'other')
            by_pack.setdefault(cid, []).append(f)
        print(f'Open findings: {len(findings)}')
        print()
        for p in packs:
            print(f\"  {p.get('fix_pack_id','')}: {p.get('title','')} ({p.get('total',0)} findings, {p.get('priority_label','?')} priority)\")
            for fid in p.get('finding_ids', [])[:5]:
                ff = next((f for f in findings if f.get('id') == fid), None)
                if ff:
                    print(f\"    {fid} [{ff.get('severity','?')}]: {ff.get('title','')}\")
            if p.get('total', 0) > 5:
                print(f\"    ... and {p['total'] - 5} more\")
            print()
    else:
        print('No findings.json found. Run a scan first.', file=sys.stderr)
        sys.exit(2)
    sys.exit(0)

if show_failed_verif:
    conn = state._conn
    if conn:
        rows = conn.execute(
            \"SELECT fingerprint, run_date, stage, command, result, output_snippet FROM verification_runs WHERE project_id=? AND result='fail' ORDER BY run_date DESC LIMIT 50\",
            (project_id,)
        ).fetchall()
        if not rows:
            print('No failed verifications found.')
        else:
            print(f'Failed verifications ({len(rows)}):')
            for r in rows:
                print(f\"  {r['run_date']} [{r['stage']}] {r['command'][:60]}\")
                if r['output_snippet']:
                    print(f\"    Output: {r['output_snippet'][:120]}\")
    else:
        print('State DB not available.', file=sys.stderr)
elif show_regressions:
    regs = state.get_regressions(project_id)
    if not regs:
        print('No regressions found.')
    for r in regs:
        print(f\"  {r['fingerprint'][:12]}... [{r['severity']}] reopened {r['reopened_count']}x: {r.get('normalized_title','')}\")
elif show_accepted:
    for status in ('ignored', 'accepted_risk', 'false_positive'):
        rows = state.get_findings(project_id, status=status)
        if rows:
            print(f\"\n{status.replace('_',' ').title()} ({len(rows)}):\")
            for r in rows:
                print(f\"  {r['fingerprint'][:12]}... [{r['severity']}]: {r.get('normalized_title','')} — {r.get('ignore_reason','')}\")
else:
    # Group by fix pack (cluster_id) when DB is available
    rows = state.get_findings(project_id)
    open_rows = [r for r in rows if r['status'] not in ('fixed','ignored','accepted_risk','false_positive')]
    print(f'Findings: {len(open_rows)} open, {len(rows)} total')
    print()

    # Try to group by fix pack from findings.json
    if fj_path and fj_path.exists():
        packs = data.get('fix_packs', [])
        findings_list = data.get('findings', [])
        for p in packs:
            pack_id = p.get('fix_pack_id', '')
            pack_fids = set(p.get('finding_ids', []))
            # Match DB rows to pack via cluster_id
            cid = pack_id.replace('FP-', '')
            pack_rows = [r for r in open_rows if r.get('cluster_id') == cid]
            if not pack_rows:
                continue
            print(f\"  {pack_id}: {p.get('title','')} ({len(pack_rows)} open, {p.get('priority_label','?')} priority)\")
            for r in pack_rows[:5]:
                print(f\"    [{r['severity']:>8}] {r['fingerprint'][:12]}... {r.get('normalized_title','')}\")
            if len(pack_rows) > 5:
                print(f\"    ... and {len(pack_rows) - 5} more\")
            print()
    else:
        # No findings.json — flat list
        for r in open_rows[:50]:
            print(f\"  [{r['status']:>8}] [{r['severity']:>8}] {r['fingerprint'][:12]}... {r.get('normalized_title','')}\")
state.close()
" "$@"
    ;;

  diff)
    exec python3 -c "
import sys
sys.path.insert(0, '${SCRIPT_DIR}')
from secforge.state import StateDB
from secforge.export_ai import resolve_session, load_findings
from pathlib import Path

reports_dir = Path('${SECFORGE_ROOT}/reports')
fj_path = resolve_session(reports_dir)
project_id = 'default'
if fj_path and fj_path.exists():
    data = load_findings(fj_path)
    project_id = data.get('target', 'default')
    scan_id = fj_path.parent.name
else:
    print('No findings.json found.', file=sys.stderr)
    sys.exit(2)

state = StateDB()
if not state.open():
    print('State DB not available. Showing findings.json summary instead.', file=sys.stderr)
    summary = data.get('summary', {})
    counts = summary.get('severity_counts', {})
    print(f\"Total: {summary.get('total_findings',0)} findings\")
    for sev in ('critical','high','medium','low','info'):
        c = counts.get(sev, 0)
        if c: print(f\"  {sev}: {c}\")
    sys.exit(0)

diff = state.get_diff(project_id, scan_id)
for label in ('new', 'reopened', 'fixed', 'existing'):
    items = diff[label]
    if items:
        print(f\"\n{label.upper()} ({len(items)}):\")
        for r in items[:20]:
            print(f\"  [{r['severity']:>8}] {r['fingerprint'][:12]}... {r.get('normalized_title','')}\")
        if len(items) > 20:
            print(f\"  ... and {len(items)-20} more\")

state.close()
" "$@"
    ;;

  history)
    exec python3 -c "
import sys
sys.path.insert(0, '${SCRIPT_DIR}')
from secforge.state import StateDB
from secforge.export_ai import resolve_session, load_findings
from pathlib import Path

args = sys.argv[1:]
finding_id = None
i = 0
while i < len(args):
    if args[i] == '--finding' and i+1 < len(args):
        finding_id = args[i+1]; i += 2
    else:
        i += 1

if not finding_id:
    print('Usage: secforge history --finding SF-###', file=sys.stderr)
    sys.exit(2)

reports_dir = Path('${SECFORGE_ROOT}/reports')
fj_path = resolve_session(reports_dir)
project_id = 'default'
if fj_path and fj_path.exists():
    data = load_findings(fj_path)
    project_id = data.get('target', 'default')

state = StateDB()
if not state.open():
    print('State DB not available.', file=sys.stderr)
    sys.exit(1)

# Resolve SF-### to fingerprint
fp = state.resolve_finding(project_id, finding_id)
if not fp:
    print(f'Finding {finding_id} not found in state DB.', file=sys.stderr)
    state.close()
    sys.exit(1)

history = state.get_finding_history(project_id, fp)
if not history:
    print(f'No history for {finding_id} (fingerprint: {fp[:16]}...)')
else:
    print(f'History for {finding_id} (fingerprint: {fp[:16]}...):')
    for h in history:
        print(f\"  {h['scan_date']} scan={h['scan_id'][:20]}... status={h['status_at_scan']} sev={h['severity']} tool={h['tool']}\")
state.close()
" "$@"
    ;;

  purge)
    exec python3 -c "
import sys
sys.path.insert(0, '${SCRIPT_DIR}')
from secforge.state import StateDB
from secforge.export_ai import resolve_session, load_findings
from pathlib import Path

args = sys.argv[1:]
before_date = None
delete_reports = '--delete-reports' in args
dry_run = '--dry-run' in args
i = 0
while i < len(args):
    if args[i] == '--before' and i+1 < len(args):
        before_date = args[i+1]; i += 2
    else:
        i += 1

if not before_date:
    print('Usage: secforge purge --before YYYY-MM-DD [--delete-reports] [--dry-run]', file=sys.stderr)
    sys.exit(2)

reports_dir = Path('${SECFORGE_ROOT}/reports')
fj_path = resolve_session(reports_dir)
project_id = 'default'
if fj_path and fj_path.exists():
    data = load_findings(fj_path)
    project_id = data.get('target', 'default')

state = StateDB()
if not state.open():
    print('State DB not available.', file=sys.stderr)
    sys.exit(1)

if dry_run:
    conn = state._conn
    scans = conn.execute('SELECT scan_id, scan_date, session_path FROM scans WHERE project_id=? AND scan_date < ?', (project_id, before_date)).fetchall()
    print(f'Would delete {len(scans)} scan(s) before {before_date}:')
    for s in scans:
        print(f\"  {s['scan_id']} ({s['scan_date']})\")
        if delete_reports and s['session_path']:
            print(f\"    → would remove {s['session_path']}\")
else:
    result = state.purge_before(project_id, before_date, delete_reports=delete_reports)
    print(f\"Purged: {result['scans_deleted']} scans, {result['finding_scans_deleted']} finding_scan records\")
state.close()
" "$@"
    ;;

  init)
    # Parse flags
    _sf_domains=(); _sf_env=""; _sf_payments=""; _sf_admin_ip=""; _sf_tier=""; _sf_reset=0
    while [[ "${#}" -gt 0 ]]; do
      case "$1" in
        --domain) _sf_domains+=("${2:-}"); shift 2 ;;
        --environment) _sf_env="${2:-}"; shift 2 ;;
        --payments) _sf_payments="${2:-}"; shift 2 ;;
        --admin-ip) _sf_admin_ip="${2:-}"; shift 2 ;;
        --tier)
          [[ "${2:-}" == "1" || "${2:-}" == "2" ]] || sf_die "--tier must be 1 or 2 (got: ${2:-empty})"
          _sf_tier="${2}"; shift 2 ;;
        --reset) _sf_reset=1; shift ;;
        -h|--help) echo "Usage: secforge init [--domain <d>] [--environment prod|staging] [--payments yes|no] [--admin-ip <ip>] [--tier 1|2] [--reset]"; exit 0 ;;
        *) sf_die "Unknown init flag: $1" ;;
      esac
    done

    _sf_cfg="${SECFORGE_ROOT}/config/secforge.conf"
    _sf_example="${_sf_cfg}.example"
    _sf_auth_file="${SECFORGE_ROOT}/config/.authorized_targets"

    # Source _lib.sh for config helpers
    # shellcheck source=/dev/null
    . "${SCRIPT_DIR}/_lib.sh"

    # --reset: backup + regenerate from template
    if [[ "${_sf_reset}" -eq 1 ]]; then
      if [[ -f "${_sf_cfg}" ]]; then
        _sf_backup="${_sf_cfg}.bak.$(date +%Y%m%d_%H%M%S)"
        cp "${_sf_cfg}" "${_sf_backup}"
        echo "Backed up to ${_sf_backup}"
      fi
      if [[ -r "${_sf_example}" ]]; then
        cp "${_sf_example}" "${_sf_cfg}"
        echo "Config reset from template."
      fi
    fi

    # Ensure config exists
    if [[ ! -f "${_sf_cfg}" ]] && [[ -r "${_sf_example}" ]]; then
      cp "${_sf_example}" "${_sf_cfg}"
    fi

    # Check for stale config (compare with .example for new keys)
    if [[ -f "${_sf_cfg}" ]] && [[ -r "${_sf_example}" ]]; then
      _sf_new_keys=()
      while IFS= read -r _sf_line; do
        _sf_key="${_sf_line%%=*}"
        [[ -z "${_sf_key}" || "${_sf_key}" == "#"* || "${_sf_key}" == "${_sf_line}" ]] && continue
        if ! grep -q "^${_sf_key}=" "${_sf_cfg}" 2>/dev/null; then
          _sf_new_keys+=("${_sf_key}")
        fi
      done < "${_sf_example}"
      if [[ "${#_sf_new_keys[@]}" -gt 0 ]]; then
        echo "New config options available: ${_sf_new_keys[*]}"
        echo "Run 'secforge init --reset' to regenerate config, or add them manually."
      fi
    fi

    # If flags provided — merge-only mode (AI/scripted)
    _sf_had_flags=0
    # Adding domains requires root (we need to write .authorized_targets which is now 0640)
    if [[ "${#_sf_domains[@]}" -gt 0 ]] && [[ "${EUID}" -ne 0 ]]; then
      sf_die "init --domain requires root. Re-run with: sudo secforge init --domain ${_sf_domains[0]}"
    fi
    if [[ "${#_sf_domains[@]}" -gt 0 ]]; then
      _sf_had_flags=1
      for _sf_d in "${_sf_domains[@]}"; do
        sf_cfg_add_list_item "${_sf_cfg}" "DOMAIN" "${_sf_d}"
        # Add to authorized targets
        if [[ -w "${_sf_auth_file}" ]] || [[ ! -e "${_sf_auth_file}" ]]; then
          if ! grep -Fqx "${_sf_d}" "${_sf_auth_file}" 2>/dev/null; then
            printf '%s\n' "${_sf_d}" >> "${_sf_auth_file}"
            echo "Authorized: ${_sf_d}"
          fi
        fi
      done
    fi
    if [[ -n "${_sf_env}" ]]; then
      _sf_had_flags=1
      sf_cfg_set_value "${_sf_cfg}" "ENVIRONMENT" "${_sf_env}"
    fi
    if [[ -n "${_sf_payments}" ]]; then
      _sf_had_flags=1
      sf_cfg_set_value "${_sf_cfg}" "PAYMENTS" "${_sf_payments}"
    fi
    if [[ -n "${_sf_admin_ip}" ]]; then
      _sf_had_flags=1
      sf_cfg_set_value "${_sf_cfg}" "ADMIN_IP" "${_sf_admin_ip}"
    fi
    if [[ -n "${_sf_tier}" ]]; then
      _sf_had_flags=1
      sf_cfg_set_value "${_sf_cfg}" "TIER_MAX" "${_sf_tier}"
    fi

    if [[ "${_sf_had_flags}" -eq 1 ]]; then
      echo "Config updated: ${_sf_cfg}"
      exit 0
    fi

    # Interactive wizard (TTY mode)
    if [[ ! -t 0 ]]; then
      echo "No flags and no TTY. Usage: secforge init --domain example.com --environment prod"
      exit 2
    fi

    echo "=== SecForge Setup Wizard ==="
    echo ""

    # Domain
    _sf_domain="$(sf_prompt_tty "What domain/URL do you want to scan?")"
    if [[ -n "${_sf_domain}" ]]; then
      # Adding a domain requires root (writes .authorized_targets which is now 0640)
      if [[ "${EUID}" -ne 0 ]]; then
        sf_die "Adding a domain requires root. Re-run with: sudo secforge init --domain ${_sf_domain}"
      fi
      sf_cfg_add_list_item "${_sf_cfg}" "DOMAIN" "${_sf_domain}"
      if [[ -w "${_sf_auth_file}" ]] || [[ ! -e "${_sf_auth_file}" ]]; then
        if ! grep -Fqx "${_sf_domain}" "${_sf_auth_file}" 2>/dev/null; then
          printf '%s\n' "${_sf_domain}" >> "${_sf_auth_file}"
        fi
      fi
    fi

    # Environment
    _sf_env_choice="$(sf_prompt_tty "Is this production or staging?" "production")"
    sf_cfg_set_value "${_sf_cfg}" "ENVIRONMENT" "${_sf_env_choice}"

    # Payments
    _sf_pay="$(sf_prompt_tty "Does this site handle payments? (yes/no)" "no")"
    sf_cfg_set_value "${_sf_cfg}" "PAYMENTS" "${_sf_pay}"

    # Tier preference
    echo ""
    echo "Scanning tiers:"
    echo "  1) Tier 1 (recommended): passive/safe checks only"
    echo "  2) Tier 2: includes active testing (SQLi, XSS payloads). Best for staging."
    _sf_tier_choice="$(sf_prompt_tty "Max scanning tier?" "1")"
    if [[ "${_sf_tier_choice}" == "2" ]]; then
      sf_cfg_set_value "${_sf_cfg}" "TIER_MAX" "2"
    else
      sf_cfg_set_value "${_sf_cfg}" "TIER_MAX" "1"
    fi

    # Admin IP
    _sf_auto_ip=""
    if [[ -n "${SSH_CONNECTION:-}" ]]; then
      _sf_auto_ip="$(echo "${SSH_CONNECTION}" | awk '{print $1}')"
    fi
    _sf_admin_ip_input="$(sf_prompt_tty "Admin IP for firewall whitelist" "${_sf_auto_ip}")"
    if [[ -n "${_sf_admin_ip_input}" ]]; then
      sf_cfg_set_value "${_sf_cfg}" "ADMIN_IP" "${_sf_admin_ip_input}"
    fi

    echo ""
    echo "Config saved: ${_sf_cfg}"
    echo ""
    echo "Next: secforge scan ${_sf_domain:-example.com}"
    ;;

  install)
    exec bash "${SCRIPT_DIR}/install-tools.sh" "$@"
    ;;

  dashboard)
    case "${1:-}" in
      --start|"")
        sf_start_dashboard
        ;;
      --restart)
        tmux kill-pane -t secforge-dashboard 2>/dev/null || \
          tmux kill-session -t secforge 2>/dev/null || true
        sf_start_dashboard
        ;;
      --last)
        exec bash "${SECFORGE_ROOT}/scripts/dashboard.sh" --last
        ;;
      --close)
        tmux kill-pane -t secforge-dashboard 2>/dev/null || \
          tmux kill-session -t secforge 2>/dev/null || true
        echo "Dashboard closed."
        ;;
      *)
        sf_die "Usage: secforge dashboard [--start|--restart|--last|--close]"
        ;;
    esac
    ;;

  status)
    exec bash "${SCRIPT_DIR}/system-check.sh"
    ;;

  update)
    exec bash "${SCRIPT_DIR}/update-all.sh"
    ;;

  ignore|accept|false-positive)
    exec python3 -c "
import sys
sys.path.insert(0, '${SCRIPT_DIR}')
from secforge.state import StateDB
from secforge.export_ai import resolve_session, load_findings
from pathlib import Path

cmd = '${cmd}'
args = sys.argv[1:]
finding_id = args[0] if args and args[0].startswith('SF-') else None
reason = ''
i = 0
while i < len(args):
    if args[i] == '--reason' and i+1 < len(args):
        reason = args[i+1]; i += 2
    elif not args[i].startswith('SF-'):
        i += 1
    else:
        i += 1

if not finding_id:
    print(f'Usage: secforge {cmd} SF-### --reason \"...\"', file=sys.stderr)
    sys.exit(2)

status_map = {'ignore': 'ignored', 'accept': 'accepted_risk', 'false-positive': 'false_positive'}
new_status = status_map.get(cmd, 'ignored')

reports_dir = Path('${SECFORGE_ROOT}/reports')
fj_path = resolve_session(reports_dir)
project_id = 'default'
if fj_path and fj_path.exists():
    data = load_findings(fj_path)
    project_id = data.get('target', 'default')

state = StateDB()
if not state.open():
    print('State DB not available.', file=sys.stderr)
    sys.exit(1)

fp = state.resolve_finding(project_id, finding_id)
if not fp:
    print(f'Finding {finding_id} not found in state DB.', file=sys.stderr)
    state.close()
    sys.exit(1)

state.set_finding_status(project_id, fp, new_status, reason)
print(f'{finding_id} marked as {new_status}' + (f': {reason}' if reason else ''))
state.close()
" "$@"
    ;;

  version)
    python3 -c "from secforge import __version__; print(f'SecForge v{__version__}')" 2>/dev/null || echo "SecForge v1"
    ;;

  help|--help|-h)
    show_help
    ;;

  *)
    echo "Unknown command: ${cmd}" >&2
    echo "Run 'secforge help' for usage." >&2
    exit 2
    ;;
esac
