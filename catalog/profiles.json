{
  "_meta": {
    "version": "1.0",
    "description": "Stack profiles. AI picks one based on detected tech. Override with --stack. Manual users get auto-detect from HTTP headers."
  },
  "go-bare": {
    "title": "Go (bare)",
    "description": "Go HTTP service without a dedicated reverse proxy detected",
    "detect_files": ["go.mod", "go.sum"],
    "detect_headers": { "Server": "go" },
    "detect_cookies": [],
    "min_detect_signals": 2,
    "tools_include": [
      "secforge-builtin",
      "wafw00f",
      "whatweb",
      "nuclei",
      "ffuf",
      "nikto",
      "nmap",
      "masscan",
      "testssl",
      "sslscan",
      "ssh-audit",
      "lynis",
      "gitleaks",
      "trufflehog",
      "osv-scanner",
      "check-email-dns",
      "subfinder",
      "httpx",
      "zap",
      "sqlmap",
      "dalfox",
      "xsstrike",
      "commix",
      "wapiti"
    ],
    "tools_exclude": ["pip-audit", "apkhunt", "apkdeeplens", "apkleaks", "oscap", "checkov", "prowler"],
    "dep_checker": "osv-scanner",
    "nuclei_tags_boost": ["go", "golang"],
    "nuclei_tags_skip": ["wordpress", "php", "java", "spring", "ruby", "rails", "python", "django", "flask", "nodejs", "express"],
    "common_endpoints": ["/health", "/healthz", "/metrics", "/debug/pprof/", "/.env", "/.git/HEAD"],
    "priority_boosts": { "secrets": 1.2, "headers": 1.1 },
    "fix_hints": {
      "headers": "Add security headers in your reverse proxy (if any) or in Go middleware; ensure cookies have Secure/HttpOnly/SameSite",
      "secrets": "Never commit secrets. Use env vars or a secrets manager; rotate any leaked credentials immediately."
    },
    "suggested_extras": [
      { "tool": "trivy", "reason": "Scans the server OS for vulnerable packages (OpenSSL, glibc). Adds ~2 min." },
      { "tool": "ssh-audit", "reason": "Confirms SSH crypto baseline if the host is reachable. Adds ~15s." }
    ]
  },
  "java-spring": {
    "title": "Java Spring",
    "description": "Spring Boot application behind nginx/tomcat",
