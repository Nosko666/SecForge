    "dep_checker": "osv-scanner",
    "nuclei_tags_boost": ["java", "spring", "tomcat"],
    "nuclei_tags_skip": ["wordpress", "php", "ruby", "rails", "python", "django", "flask", "nodejs", "express"],
    "common_endpoints": ["/actuator/health", "/actuator", "/swagger-ui/", "/v3/api-docs", "/.env", "/.git/HEAD"],
    "priority_boosts": { "misconfig": 1.1, "secrets": 1.2 },
    "fix_hints": {
      "misconfig": "Disable or lock down Spring Actuator endpoints; require auth and restrict to internal networks",
      "headers": "Add security headers at nginx/tomcat layer (CSP, HSTS, X-Frame-Options)",
      "secrets": "Move secrets out of application.properties/yml; use env vars or a secrets manager."
    },
    "suggested_extras": [
      { "tool": "trivy", "reason": "Detects vulnerable system packages and CVEs on the server OS. Adds ~2 min." }
    ]
  },
